# Copy to .env.local and adjust. src/env.ts validates every variable, and the app refuses to
# start if one is missing or malformed. Never commit .env.local or real values.

# Base URL of the CLANOS API (a separate backend), without a trailing slash. The CSP only lets
# the browser call this origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server only. Name of the httpOnly session cookie the API sets. The proxy only checks that it
# exists to redirect signed-out visitors; the API decides who is actually signed in.
SESSION_COOKIE_NAME=clanos_session

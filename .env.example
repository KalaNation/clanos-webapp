# Copy to .env.local and adjust. Never commit .env.local or real values.

# Base URL of the CLANOS API (a separate backend), without a trailing slash. The CSP lets the
# browser call only this origin; if it's unset, the browser can call only this app.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server only. Name of the httpOnly session cookie the API sets (default: clanos_session). The
# proxy only checks that it exists to redirect signed-out visitors; the API decides who is signed in.
SESSION_COOKIE_NAME=clanos_session
